# Normalize text files to LF in the repository.
* text=auto eol=lf

# Keep Windows command and script files usable with CRLF working-tree endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Treat common binary assets as binary.
*.dll binary
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
